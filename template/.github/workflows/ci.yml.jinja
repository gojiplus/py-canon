name: CI

on:
  push:
    branches: [{{ default_branch }}]
  pull_request:
  schedule:
    - cron: "17 6 * * 1"  # weekly: surface ecosystem drift on quiet repos
  # A merge made with GITHUB_TOKEN does not trigger workflows, so an
  # auto-merged Dependabot PR leaves the default branch at a commit no CI run
  # ever covered. The auto-merge sweep dispatches this after it lands one.
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  ci:
    uses: gojiplus/py-canon/.github/workflows/reusable-ci.yml@v1
    with:
      wheel-import: {{ package_name }}
      coverage-floor: {{ coverage_floor }}
      run-preen: true
